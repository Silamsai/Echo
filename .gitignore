# ─── Echo — Root .gitignore ─────────────────────────────────────
# This file covers both frontend/ and backend/ directories

# ─── Dependencies ───────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment Variables ─── NEVER COMMIT SECRETS ─────────────
.env
.env.*
!.env.example
.dev.vars
.wrangler/
**/.wrangler/

# ─── Build Output ────────────────────────────────────────────────
dist/
build/
**/dist/
**/build/
dist-ssr/

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Uploads (local storage fallback) ────────────────────────────
uploads/

# ─── OS & Editor files ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Vite / Bundler Cache ────────────────────────────────────────
.vite/
*.local
.vercel
.env*
